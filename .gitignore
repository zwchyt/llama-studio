# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostics
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
jspm_packages/
package-lock.json

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# dotenv environment variables file
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build files
dist/
dist-ssr/
out/
release/
build/
*.tsbuildinfo

# App-specific runtime/download folders
models/*
!models/.gitkeep

backend/*
!backend/.gitkeep

templates/*
!templates/.gitkeep

# 聊天数据：目录和子目录全部入库，只忽略各「叶子目录」里的文件。
# 注意这里没有 chats/* 或 chats/** —— 那种写法会连目录本身一起匹配掉。
# 下面每条都只作用在某个目录的「内容」上（dir/* 不会匹配 dir 本身），
# 再用 !dir/.gitkeep 保留占位文件，空目录才能留在仓库里。
chats/sessions/*
!chats/sessions/.gitkeep
chats/assets/images/*
!chats/assets/images/.gitkeep
chats/assets/pdf_exports/*
!chats/assets/pdf_exports/.gitkeep
chats/state/token-usage/*
!chats/state/token-usage/.gitkeep
chats/state/imagegen-history/*
!chats/state/imagegen-history/.gitkeep

# 本地知识库数据（用户文档与索引，不入库；保留空文件夹）
knowledge/*
!knowledge/.gitkeep

chat-templates/*
!chat-templates/.gitkeep

# 图表测试页（Mermaid / Recharts / SVG）预设：
# chart-presets/ 本身、以及它的三个子目录都入库（靠 .gitkeep 保留空文件夹），
# 只有用户自己往三个子目录里添加的预设文件不入库。
chart-presets/mermaid/*
chart-presets/recharts/*
chart-presets/svg/*
!chart-presets/mermaid/.gitkeep
!chart-presets/recharts/.gitkeep
!chart-presets/svg/.gitkeep
# 用户运行时添加的模型 Logo（不入库；保留空文件夹）
src/renderer/public/logos/*
!src/renderer/public/logos/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime config (user-specific local paths)
settings.json

# 模型能力检测缓存（每台机器运行时生成，不入库）
# 注：用户 Logo 映射与图片的实际路径是 src/renderer/public/logos/，已由上方规则覆盖
/model-capabilities.json

# Agent Code 工作台会话记录（用户数据，不入库；保留空文件夹，仅忽略日志文件）
Agent session/*
!Agent session/.gitkeep

# Windows reserved device name (some tools may create this accidentally)
nul

# Agent 认知模块离线验收/压测脚本（本地回归工具）及其运行产物；
# 注意：scripts/build-filtered.js 被 npm run build 引用，必须保留入库
scripts/electron-stub.ts
scripts/lucide-stub.cjs
scripts/test-*-entry.ts
scripts/.test-*

# Vinv local artifacts (captures, index, reports)
.vinv/

# ── 测试基础设施产物（本地生成，不入库）──
test-results/
playwright-report/
blob-report/
playwright/.cache/
tests/
vitest.config.ts
playwright.config.ts
scripts/audit-secrets.mjs
.gitleaks.toml
settings.json.bak