# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostics
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# dotenv environment variables file
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build files
dist/
dist-ssr/
out/
release/
build/
*.tsbuildinfo

# App-specific runtime/download folders
models/*
!models/.gitkeep

backend/*
!backend/.gitkeep

templates/*
!templates/.gitkeep

chats/*
!chats/.gitkeep

# 本地知识库数据（用户文档与索引，不入库；保留空文件夹）
knowledge/*
!knowledge/.gitkeep

chat-templates/*
!chat-templates/.gitkeep

# Agent instructions (not part of source code)
AGENTS.md

# 用户运行时添加的模型 Logo（不入库；保留空文件夹）
src/renderer/public/logos/*
!src/renderer/public/logos/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime config (user-specific local paths)
settings.json

# Agent Code 工作台会话记录（用户数据，不入库；保留空文件夹，仅忽略日志文件）
Agent session/*
!Agent session/.gitkeep

# Windows reserved device name (some tools may create this accidentally)
nul

# Agent 认知模块离线验收/压测脚本（本地回归工具）及其运行产物；
# 注意：scripts/build-filtered.js 被 npm run build 引用，必须保留入库
scripts/electron-stub.ts
scripts/lucide-stub.cjs
scripts/test-*-entry.ts
scripts/.test-*

# Bundled node runtime (build artifact)

